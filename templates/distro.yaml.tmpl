# This file is generated from templates/distro.yaml.tmpl by .github/workflows/render.yaml.
# Edit the template or versions/<version>.yaml, not this file.

---
# yaml-language-server: $schema=https://raw.githubusercontent.com/colonel-byte/cargoship/refs/heads/main/schema/distro-v1alpha1-schema.json
apiVersion: colonel-byte.dev/v1alpha1
kind: Distro
metadata:
  name: rancher-rke2
  version: {{ .version }}
  architecture: amd64
  uncompressed: false
spec:
  type: rke2
  version: {{ .version }}
  config:
    engine:
      config:
        # keep-sorted start block=yes
        cluster-cidr: 10.42.0.0/16
        cluster-domain: cluster.local
        cni:
          - cilium
        disable-cloud-controller: true
        disable-kube-proxy: true
        disable:
          - rke2-ingress-nginx
        embedded-registry: false
        etcd-arg:
          - "quota-backend-bytes=8589934592" # 8GB
          - "auto-compaction-retention=1h"
        kube-apiserver-arg:
          - anonymous-auth=false
          - audit-log-mode=blocking-strict
          - audit-log-maxage=30
          - authorization-mode=RBAC,Node
          - "tls-min-version=VersionTLS12"
          - "service-account-extend-token-expiration=false"
          - "tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
        kube-controller-manager-arg:
          - "tls-min-version=VersionTLS12"
          - "tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
          - bind-address=127.0.0.1
          - use-service-account-credentials=true
        kube-proxy-arg:
          - "ipvs-strict-arp=true"
        kube-scheduler-arg:
          - "tls-min-version=VersionTLS12"
          - "tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
        kubelet-arg:
          - authorization-mode=Webhook
          - anonymous-auth=false
          - streaming-connection-idle-timeout=5m
          - read-only-port=0
        profile: cis
        protect-kernel-defaults: true
        selinux: true
        service-cidr: 10.43.0.0/16
        write-kubeconfig-mode: "0600"
        # keep-sorted end
      # STIG V-254555 (CNTR-R2-000* / CAT II). cargoship writes this to
      # /etc/rancher/rke2/audit.yaml and points kube-apiserver's audit-policy-file at it,
      # adding "kind: Policy" and "apiVersion: audit.k8s.io/v1" itself.
      #
      # The rules are the ones the STIG's check text requires verbatim: secrets at Metadata so
      # their contents never reach the log, everything else at RequestResponse. This is loud --
      # RequestResponse on every resource logs full request and response bodies -- which is the
      # cost the requirement accepts. Size the audit log volume for it.
      audit:
        metadata:
          name: rke2-audit-policy
        rules:
          - level: Metadata
            resources:
              - group: ""
                resources:
                  - secrets
          - level: RequestResponse
            resources:
              - group: ""
                resources:
                  - "*"
      podSecurity:
        plugins:
          - name: PodSecurity
            configuration:
              apiVersion: pod-security.admission.config.k8s.io/v1beta1
              kind: PodSecurityConfiguration
              defaults:
                enforce: "restricted"
                enforce-version: "latest"
                audit: "restricted"
                audit-version: "latest"
                warn: "restricted"
                warn-version: "latest"
              exemptions:
                usernames: []
                runtimeClasses: []
                namespaces:
                  - kube-system
                  - rook-ceph
                  - zarf
      manifest:
        rke2-cilium: |-
          kubeProxyReplacement: true
          k8sServiceHost: "localhost"
          k8sServicePort: "6443"
          encryption:
            enabled: true
            type: wireguard
          tolerations:
            - operator: Exists
          operator:
            tolerations:
              - operator: Exists
    os:
      sysctl:
        # Istio related sysctl overrides
        "fs.inotify.max_user_watches": "11048576"
        "fs.inotify.max_user_instances": "8192"
        # Misc performance
        "vm.max_map_count": "262144"
        "fs.file-max": "2097152"
        # Network tuning
        "net.core.somaxconn": "32768"
        "net.ipv4.tcp_max_syn_backlog": "8192"
        "net.core.netdev_max_backlog": "16384"
        # NFTABLES
        "net.netfilter.nf_conntrack_max": "1000000"
        "net.netfilter.nf_conntrack_buckets": "250000"
        "net.netfilter.nf_conntrack_tcp_timeout_established": "86400"
        "net.netfilter.nf_conntrack_tcp_timeout_close_wait": "3600"
        # Network
        "net.ipv4.ip_forward": "1"
        "net.ipv6.conf.all.forwarding": "1"
        "net.bridge.bridge-nf-call-iptables": "1"
        "net.bridge.bridge-nf-call-ip6tables": "1"
        # RKE2 related sysctl overrides
        "vm.panic_on_oom": "0"
        "vm.overcommit_memory": "1"
        "kernel.panic": "10"
        "kernel.panic_on_oops": "1"
      fapolicyd: |
        # Allow RKE2 to function
        allow perm=any all : dir=/opt/cni/
        allow perm=any all : dir=/run/k3s/
        allow perm=any all : dir=/var/lib/kubelet/
        allow perm=any all : dir=/var/lib/rancher/
      files:
        - source: https://rpm.rancher.io/rke2/latest/{{ .minor }}/centos/9/x86_64/rke2-common-{{ .rpmVersion }}-0.el9.x86_64.rpm
          target: /var/lib/rancher/rke2/rpm/rke2-common-{{ .rpmVersion }}-0.el9.x86_64.rpm
          shasum: {{ .rpms.common }}
          selector:
            package: rpm
        - source: https://rpm.rancher.io/rke2/latest/common/centos/9/noarch/rke2-selinux-{{ .selinux.version }}.el9.noarch.rpm
          target: /var/lib/rancher/rke2/rpm/rke2-selinux-{{ .selinux.version }}.el9.noarch.rpm
          shasum: {{ .selinux.shasum }}
          selector:
            package: rpm
        - source: https://rpm.rancher.io/rke2/latest/{{ .minor }}/centos/9/x86_64/rke2-server-{{ .rpmVersion }}-0.el9.x86_64.rpm
          target: /var/lib/rancher/rke2/rpm/rke2-server-{{ .rpmVersion }}-0.el9.x86_64.rpm
          shasum: {{ .rpms.server }}
          selector:
            package: rpm
            profile: controller
        - source: https://rpm.rancher.io/rke2/latest/{{ .minor }}/centos/9/x86_64/rke2-agent-{{ .rpmVersion }}-0.el9.x86_64.rpm
          target: /var/lib/rancher/rke2/rpm/rke2-agent-{{ .rpmVersion }}-0.el9.x86_64.rpm
          shasum: {{ .rpms.agent }}
          selector:
            package: rpm
            profile: worker
    files:
      - source: core/cache.json
        target: /var/lib/rancher/rke2/agent/images/.cache.json
      # rke2 ships no etcdctl, which is the tool you want on a control-plane node when etcd is
      # the thing that is wrong. The version tracks the hardened-etcd image this release
      # bundles, so the client matches the server. Phase 50 uploads it and no later phase
      # renames it, so it is in place as soon as the upload finishes.
      - source: https://github.com/etcd-io/etcd/releases/download/v{{ .etcd.version }}/etcd-v{{ .etcd.version }}-linux-amd64.tar.gz
        extractPath: etcd-v{{ .etcd.version }}-linux-amd64/etcdctl
        target: /usr/local/bin/etcdctl
        executable: true
        shasum: {{ .etcd.shasum }}
        selector:
          profile: controller
    imageConfig:
      path: /var/lib/rancher/rke2/agent/images
      compression: none
      images:
{{- range .images }}
        - {{ . }}
{{- end }}
